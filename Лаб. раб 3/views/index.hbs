    <div class="container">
        <div class="header">
            <h1 class="page-title" id="pageTitle">Освидетельствование имущества</h1>
            <p class="page-subtitle">Отчет о проведенных проверках имущества предприятия</p>
        </div>

        <div class="instrumental-panel">
            <div class="add-buttons-container">
                <button type="button" class="go-button add-button" id="addShipModalButton">Добавить корабль +</button>
                <button type="button" class="go-button add-button" id="addPropertyButton">Добавить имущество +</button>
            </div>
            <button type="button" class="go-button logout-button" id="logoutButton">Выйти X</button>
        </div>

