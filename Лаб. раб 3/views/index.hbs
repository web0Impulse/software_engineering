<body>
    {{!-- Модальное окно для добавления корабля --}}
    <div id="addShipModal" class="modal hidden">
        <div class="modal-content">
            <span class="close-btn" id="closeShipModalSign">&times;</span>
            {{!-- Ошибка --}}
            <div class="error-div" id="addShipSubmitError"></div>
            <form action="#" id="addShipForm">
                {{!-- Название корабля --}}
                <div class="form-group">
                    <label for="name">Название</label>
                    <input type="text" class="modal-input" id="shipName" name="name" required>
                </div>
                {{!-- Кнопки --}}
                <div class="form-actions">
                    <button type="submit" class="go-button add-button" id="addShipButton">Добавить</button>
                    <button type="button" class="go-button logout-button" id="closeShipModalButton">Отмена</button>
                </div>
            </form>
        </div>
    </div>
