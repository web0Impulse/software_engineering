        <div class="table-section">
            <div class="table-container" id="pyrotechnicsContainer">
                <table id="pyrotechnicsTable">
                    <thead>
                        <tr>
                            <th>Наименование</th>
                            <th>Тип</th>
                            <th>Кол.</th>
                            <th>Корабль</th>
                            <th>Расположение</th>
                            <th>Дата пред. проверки</th>
                            <th>Отметка о выполнении</th>
                            <th>Дата след. проверки</th>
                            <th>Периодичность проверки</th>
                            <th>Результат</th>
                            {{!-- <th>Действия</th> --}}
                        </tr>
                    </thead>
                    <tbody>
                        {{#each property}}
                            <tr>
                                <td>{{this.name}}</td>
                                <td>{{this.property_type.name}}</td>
                                <td>{{this.quantity}}</td>
                                <td>{{this.ship.name}}</td>
                                <td>{{this.location}}</td>
                                <td>{{this.date_prev_inspection}}</td>
                                <td>{{this.check_mark}}</td>
                                <td>{{this.date_prev_inspection}}</td>
                                <td>{{this.frequency_of_inspection}} дн.</td>
                                <td>{{this.is_ok}}</td>
                                {{!-- <td class="actions">
                                    <button class="btn">Просмотр</button>
                                </td> --}}
                            </tr>
                        {{/each}}
                    </tbody>
                </table>    
            </div>
        </div>
